{
  "name": "sala-de-roteiro-95",
  "productName": "ScriptRoom",
  "version": "6.1.1",
  "description": "ScriptRoom: editor de roteiros de TV com cara de 1995, para qualquer série: drama, novela, comédia, policial, radionovela e mais. Lê e grava .docx, .fdx (Final Draft), PDF e Fountain.",
  "main": "main.js",
  "author": "Departamento de Dramaturgia",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "instalador": "electron-builder --win nsis",
    "portatil": "electron-builder --win portable",
    "publicar": "electron-builder --win nsis --publish always",
    "configurar-repo": "node scripts/configurar-repo.js"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "br.c2.saladeroteiro95",
    "productName": "ScriptRoom",
    "copyright": "Departamento de Dramaturgia · C2",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "app/**/*",
      "build/icon.png"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "ScriptRoom_portatil.exe"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/installerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "license": "build/licenca.txt",
      "include": "build/installer.nsh",
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "ScriptRoom",
      "menuCategory": "ScriptRoom",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "pt_BR"
      ],
      "language": "1046",
      "artifactName": "SETUP_SCRIPTROOM_${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "SEU-USUARIO",
      "repo": "sala-de-roteiro-95",
      "releaseType": "release"
    }
  },
  "repository": "https://github.com/SEU-USUARIO/sala-de-roteiro-95",
  "dependencies": {
    "electron-updater": "6.3.9"
  }
}
